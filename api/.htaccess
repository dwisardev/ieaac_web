<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /api/

    # cPanel/Apache elimina el header Authorization antes de pasarlo a PHP.
    # Esta regla lo reinyecta como variable de entorno para que
    # $_SERVER['HTTP_AUTHORIZATION'] llegue correctamente al middleware Auth.
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Si el archivo o directorio existe, servir directamente
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d

    # Todo lo demas va a index.php
    RewriteRule ^(.*)$ index.php [QSA,L]
</IfModule>

AddDefaultCharset UTF-8

# ── Límites de subida de archivos ────────────────────────────
<IfModule mod_php.c>
    php_value upload_max_filesize 10M
    php_value post_max_size 12M
    php_value max_execution_time 60
    php_value memory_limit 128M
</IfModule>
<IfModule mod_php8.c>
    php_value upload_max_filesize 10M
    php_value post_max_size 12M
    php_value max_execution_time 60
    php_value memory_limit 128M
</IfModule>
